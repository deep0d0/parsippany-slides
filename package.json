{
  "name": "parsippany-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && vite build --config vite.server.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node dist-server/index.mjs",
    "build:cloudflare": "vite build --config vite.cloudflare.config.ts",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "types": "wrangler types",
    "import": "python3 scripts/import_pptx.py"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.15.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wrangler": "^4.45.0"
  }
}
